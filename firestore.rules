rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- role helpers (role stored on users/{uid}) ----
    function hasUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() {
      return hasUser() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : '';
    }
    // A coach (incl. a coach+athlete "both" account) can program & manage.
    function isCoach() { return role() == 'coach' || role() == 'both'; }
    // "team" = anyone supporting athletes: coach, both, crew (or legacy staff/coordinator).
    function isTeam() { return isCoach() || role() == 'crew' || role() == 'staff' || role() == 'coordinator'; }

    // Everyone signed in can read the roster of names/profiles; you write only your own.
    // A coach may delete a profile (removing an old/test member from the team hub).
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isCoach();
    }

    // Per-athlete data: team roles read ALL; an athlete reads/writes their own doc;
    // another athlete may READ it only if the owner listed them in `viewers` (opt-in sharing).
    match /athletes/{aid} {
      allow read: if isTeam()
        || (request.auth != null && request.auth.uid == aid)
        || (request.auth != null && request.auth.uid in resource.data.get('viewers', []));
      allow write: if isCoach() || (request.auth != null && request.auth.uid == aid);
    }

    // Coach-managed shared content (coaches list, workout templates, questionnaires, reminders).
    match /shared/{doc} {
      allow read: if request.auth != null;
      allow write: if isCoach();
    }

    // Coordinator to-do tasks — small trusted team: any signed-in member can read/write.
    match /todos/{id} {
      allow read, write: if request.auth != null;
    }
    // Comments on workouts — any signed-in member can read/add/update.
    match /comments/{id} {
      allow read, write: if request.auth != null;
    }
    // Athlete ↔ athlete access requests.
    match /shareRequests/{id} {
      allow read, write: if request.auth != null;
    }

    // Push tokens: each user writes their own; team roles may read (sending uses the admin key).
    match /pushTokens/{uid} {
      allow read: if isTeam() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // "Send now" queue — any signed-in member can enqueue (staff↔athlete both directions).
    match /pushQueue/{id} {
      allow read, write: if request.auth != null;
    }
    // Send-log written by the admin push server; readable by signed-in members.
    match /pushLog/{id} {
      allow read, write: if request.auth != null;
    }

    // Legacy phase-1 doc (used once for migration, then ignored).
    match /team/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
